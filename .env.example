# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> Database -> Connection string (pooler, port 6543), .NET format
SUPABASE_DB_URL=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.YOURREF;Password=YOURPASSWORD;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Optional: password for the seeded training accounts (default Acme@2026). Used only when the database is first created.
# SEED_USER_PASSWORD=
