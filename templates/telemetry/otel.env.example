# Claude Code OpenTelemetry. Put these in managed settings ("env" block) or each user's
# ~/.claude/settings.json. Claude Code ignores telemetry exporter variables in a repo's
# .claude/settings.json.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.example.internal:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token from your secret store>
# Optional labels for dashboards:
OTEL_RESOURCE_ATTRIBUTES=department=engineering,team=platform
# Leave prompt logging OFF (default). See README PDPA note.
# OTEL_LOG_USER_PROMPTS=1
