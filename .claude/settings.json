{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet run *)",
      "Bash(npm run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(bash .claude/skills/release-notes/scripts/commits.sh)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env.local)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "mcp__render__create_web_service",
      "mcp__render__create_static_site",
      "mcp__render__create_cron_job",
      "mcp__render__create_postgres",
      "mcp__render__create_key_value",
      "mcp__render__update_web_service",
      "mcp__render__update_static_site",
      "mcp__render__update_cron_job",
      "mcp__render__update_environment_variables"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/run-tests.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/block-secrets.js"
          }
        ]
      }
    ]
  }
}
